# ============================================================================
# .env.example — the single configuration surface for the mapshot sidecar.
#
# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
#
# The file is used three ways:
#   1. docker compose reads it for ${...} interpolation (mounts)
#   2. docker compose passes it into the container (env_file)
#   3. render.sh sources it for host-side runs (`bash render.sh check`)
# It must stay valid bash: plain VAR=value lines, shell-safe/quoted values,
# no commands. See the integration contract in the README for details.
# ============================================================================

# --- AMP instance -----------------------------------------------------------

# Host path of the AMP instances root (the parent directory that holds all
# AMP instance directories).
AMP_DATA_ROOT=/home/amp/.ampdata/instances

# REQUIRED: name of the AMP instance directory under AMP_DATA_ROOT. The FULL
# instance directory is mounted read-only into the container at /instance
# (saves/, mods/ and the Factorio data dir are all read from there). Find the
# name in the AMP UI, via `docker ps`, or:
#   ls /home/amp/.ampdata/instances/
AMP_INSTANCE_NAME=

# --- Save selection ---------------------------------------------------------

# Exact save filename inside the instance's saves/ directory (e.g.
# "mysave.zip"). Empty = pick the newest *.zip automatically; the auto pick
# is skipped for files younger than 120s and is still integrity-checked.
SAVE_NAME=

# --- Factorio client --------------------------------------------------------

# Manual Factorio version override (e.g. "2.0.28"). Empty = auto-detect from
# the instance's own Factorio data (data/base/info.json). Detection failure
# is fatal with an actionable message, not a guess.
FACTORIO_VERSION=

# Download edition of the full Factorio client: "alpha" (base game WITHOUT
# Space Age) or "expansion" (WITH Space Age). Empty = auto-detect:
# "expansion" when the instance's mods/mod-list.json enables the "space-age"
# mod, "alpha" otherwise.
FACTORIO_EDITION=

# REQUIRED for the first client download: factorio.com account credentials.
# factorio.com's download endpoint takes them as username/token QUERY
# PARAMETERS (it rejects HTTP basic auth). At runtime render.sh writes the
# authenticated URL into a curl config on tmpfs (/run/factorio.curlcfg,
# mode 0600) that curl reads via -K, so the token never appears in argv,
# command lines or logs — only in that 0600 tmpfs file, which is deleted as
# soon as the download finishes. Not needed while a cached client matches
# the detected version. The token is account-scoped: rotate it from your
# factorio.com profile page if it leaks.
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# --- mapshot render parameters ----------------------------------------------

# What to include: "player" | "entities" | "all". "entities" captures the
# base without rendering the whole world; SE players: start here.
MAPSHOT_AREA=entities

# Which game surface to render: "_all_" (every surface, e.g. SE satellites)
# or a single one such as "nauvis" (quick tests on SE).
MAPSHOT_SURFACE=_all_

# Zoom-level bounds in in-game units per tile: smallest (most detailed) and
# largest layer. tilemax=0 means "use the game's default coarsest zoom
# bound" (upstream mapshot semantics — NOT "unbounded"). 64 is a good
# SE+K2 start for tilemin.
MAPSHOT_TILEMIN=64
MAPSHOT_TILEMAX=0

# JPEG quality (and the floor quality for empty tiles; 0 disables empty-tile
# rendering). 85-90 recommended for megabase renders.
MAPSHOT_JPGQUALITY=85
MAPSHOT_MINJPGQUALITY=85

# Escape hatch: appended verbatim to the `mapshot render` command line.
# Example: MAPSHOT_EXTRA_ARGS="--resolution 2048"
MAPSHOT_EXTRA_ARGS=

# --- Output, retention, disk -------------------------------------------------

# Host directory bound to /output in the container; this is what Caddy
# serves (final layout: <dir>/renders/<timestamp>_<save>, <dir>/latest).
OUTPUT_DIR_HOST=/srv/factorio-maps

# How many rendered map versions to keep under renders/ (oldest pruned).
RETENTION_COUNT=3

# How many version-keyed full Factorio clients to keep in the /cache volume
# (each is ~1-2 GB; pruned newest-by-mtime after a successful render).
CLIENT_CACHE_COUNT=2

# Pre-flight floor: render is skipped with a clear error if /output or /cache
# has less free space than this. On /output the guard adds ~3 GB on top of
# this floor, because the render sandbox holds a full copy of the Factorio
# client (~2.5 GB) next to the render output.
MIN_FREE_GB=10

# --- Performance -------------------------------------------------------------

# Caps llvmpipe (software GL) render threads to bound CPU contention with
# the live game server. Empty = llvmpipe default (one thread per core).
LP_NUM_THREADS=

# Virtual display geometry for Xvfb. Try a different depth (e.g. 24) if GL
# init fails.
XVFB_SCREEN=1920x1080x24

# Hard cap in seconds around the render itself (default 6h). systemd's
# TimeoutStartSec on the unit must stay >= this plus download/extract time.
RENDER_TIMEOUT_SECS=21600

# --- Environment passthrough -------------------------------------------------
# Anything set here reaches the container via env_file. Example (fallback for
# GL crashes: force Mesa software rendering; the Dockerfile already sets it):
# LIBGL_ALWAYS_SOFTWARE=1
