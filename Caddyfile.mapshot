# ============================================================================
# Caddyfile.mapshot — importable Caddy snippet serving the public map viewer.
#
# The snippet is named (factorio_maps). It never activates anything by itself;
# it only takes effect when imported into a site block of your existing
# Caddyfile (see the integration example at the bottom).
#
# Validation after integration (on the server):
#   caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# This file is deployed OUTSIDE the container: after a `git pull` changes it,
# re-copy it to /etc/caddy/ and reload Caddy — compose build does not touch it.
#
# --- What it serves ----------------------------------------------------------
#
# Root is <OUTPUT_DIR_HOST> (default /srv/factorio-maps — the OUTPUT_DIR_HOST
# bind, NOT latest/). Three public surfaces:
#
#   /                                 → timeline homepage: a static index.html
#                                       that render.sh regenerates after every
#                                       render (and after every skipped one),
#                                       listing all published renders
#                                       newest-first
#   /latest/                          → the newest map (the `latest` symlink
#                                       render.sh swaps atomically after every
#                                       render); / shows it too via the
#                                       "latest" badge on the newest entry
#   /renders/<timestamp>_<save>/index.html → archived views of older renders
#                                       (the "time travel" history, depth =
#                                       RETENTION_COUNT)
#
# ADJUST THE ROOT if you changed OUTPUT_DIR_HOST in .env: the path below must
# be exactly "<OUTPUT_DIR_HOST>" (not "<OUTPUT_DIR_HOST>/latest" — the
# timeline and the renders/ archive live one level above latest/).
#
# Non-public entries stay hidden via file_server's `hide` rule (exact
# dotfile/dir names, matched against the base name — sufficient here):
# .staging/ (per-run scratch, wiped after every run) and .render.lock (flock
# target). The .latest.tmp.* symlinks from the atomic swap exist only for
# microseconds and cannot be hidden by exact name (the name carries the PID);
# render-meta.txt files inside each render dir are harmless metadata that
# ships with the render.
#
# --- Caching -----------------------------------------------------------------
#
# Two mutually exclusive matchers cover the whole URL space (each request
# matches exactly one):
#
# - Everything except tile data gets Cache-Control "no-cache". Under latest/
#   the CONTENT changes completely with every render, so browsers must
#   revalidate; the archive pages (/renders/<ts>_<save>/) are actually frozen
#   once published, but revalidation there is still just cheap Last-Modified
#   304s — accepted for the simplicity of one matcher scheme.
# - Exception — tile data under d-<hash>/: every render writes its tiles into
#   one d-<hash>/ directory (hash unique to that render) and a fresh render
#   creates a NEW d-<hash>/ rather than touching old ones. Those URLs are
#   content-frozen everywhere (latest/ AND renders/), so they are cached
#   aggressively (1 year, immutable). index.html / js stay no-cache.
#
# --- Compression ---------------------------------------------------------------
#
# zstd/gzip are restricted to text-ish types (html/css/js/json + text/*).
# The map's JPEG tiles are already compressed: compressing them again wastes
# CPU on the server and shrinks nothing, so jpeg/jpg are explicitly excluded
# by this Content-Type allowlist.
#
# --- Renders ------------------------------------------------------------------
#
# The `latest` symlink is swapped via a single atomic rename(2) after each
# render; Caddy resolves it per request, so new renders are picked up
# immediately — NO Caddy reload is needed between renders. The timeline
# index.html is rewritten (temp + mv) after every render or skip the same
# way.
# ============================================================================

(factorio_maps) {
	root * /srv/factorio-maps

	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json
			header Content-Type application/javascript
		}
	}

	# Mutually exclusive matchers so the two header rules can never both fire
	# (each request matches exactly one).
	@tiles path *d-*/*
	header @tiles Cache-Control "public, max-age=31536000, immutable"

	@notTiles not path *d-*/*
	header @notTiles Cache-Control "no-cache"

	file_server {
		# Exact base names: hides .staging/ and .render.lock in any
		# directory. (.latest.tmp.* is microseconds-only during the atomic
		# swap; render-meta.txt is harmless metadata.)
		hide .staging .render.lock
	}
}

# ============================================================================
# Integration example — how to import this snippet into an existing Caddyfile
# ============================================================================
#
# 1. Copy this file next to your Caddyfile, e.g.:
#      sudo cp Caddyfile.mapshot /etc/caddy/Caddyfile.mapshot
#
# 2. In /etc/caddy/Caddyfile, import it at the top (paths are relative to the
#    main Caddyfile's directory, so a bare name works for /etc/caddy/):
#
#      import Caddyfile.mapshot
#
# 3. In the site that should serve the map, import the snippet:
#
#      map.example.com {
#      	import factorio_maps
#      }
#
# 4. Validate and reload:
#      caddy validate --config /etc/caddy/Caddyfile
#      sudo systemctl reload caddy
# ============================================================================
